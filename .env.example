# Copy this file to .env and fill in the values you need.

# Port the server listens on
PORT=3000

# Secret token required to read stored messages at GET /api/messages
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Optional: send each contact message to your inbox via SMTP.
# Leave these empty to only store messages on disk (data/messages.json).
# Gmail example: host smtp.gmail.com, port 465, secure true, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO=rakibhasanbappy321@gmail.com
